<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Solo estas dos claves: cualquier otra clave de sandbox (o
	     get-task-allow) en un hijo con inherit hace que libsecinit lo aborte.
	     Ver .planning/research/APPSTORE.md. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.inherit</key>
	<true/>
</dict>
</plist>
